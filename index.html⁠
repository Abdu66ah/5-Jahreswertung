            { rank: 10, flag: "🇨🇿", name: "Tschechien", code: "CZE", s1: 6.750, s2: 13.500, s3: 9.300, s4: 11.000, s5: 9.200, teams: "3/5" },
            { rank: 11, flag: "🇸🇨", name: "Schottland", code: "SCO", s1: 3.500, s2: 6.400, s3: 11.200, s4: 9.000, s5: 7.500, teams: "2/5" },
            { rank: 12, flag: "🇨🇭", name: "Schweiz", code: "SUI", s1: 8.500, s2: 5.200, s3: 10.000, s4: 8.800, s5: 6.400, teams: "2/5" },
            { rank: 13, flag: "🇦🇹", name: "Österreich", code: "AUT", s1: 4.900, s2: 4.800, s3: 8.400, s4: 7.600, s5: 6.200, teams: "2/5" },
            { rank: 14, flag: "🇳🇴", name: "Norwegen", code: "NOR", s1: 5.750, s2: 8.000, s3: 5.375, s4: 8.250, s5: 6.125, teams: "2/4" },
            { rank: 15, flag: "🇬🇷", name: "Griechenland", code: "GRE", s1: 2.125, s2: 11.400, s3: 9.000, s4: 6.200, s5: 5.800, teams: "2/4" }
        ];

        let currentViewMode = 'current'; // 'current' or 'forecast'

        // Render Table Data
        function renderTable() {
            const tbody = document.getElementById('table-body');
            tbody.innerHTML = '';

            let dataToDisplay = [...countryData];

            if (currentViewMode === 'forecast') {
                // Calculate forecasted score (drop season 1)
                dataToDisplay = dataToDisplay.map(c => {
                    const forecastPoints = c.s2 + c.s3 + c.s4 + c.s5;
                    return { ...c, total: forecastPoints };
                }).sort((a, b) => b.total - a.total);
            } else {
                dataToDisplay = dataToDisplay.map(c => {
                    const totalPoints = c.s1 + c.s2 + c.s3 + c.s4 + c.s5;
                    return { ...c, total: totalPoints };
                }).sort((a, b) => b.total - a.total);
            }

            document.getElementById('country-count').innerText = dataToDisplay.length;

            dataToDisplay.forEach((item, index) => {
                const currentRank = index + 1;
                const total = item.total.toFixed(3);

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-800/60 transition border-b border-uefa-borderDark/40 cursor-pointer";
                tr.onclick = () => openModal(item, currentRank);

                const slotsBadge = getSlotsBadge(currentRank);

                tr.innerHTML = `
                    <td class="py-3 px-3 text-center font-bold text-slate-300">${currentRank}</td>
                    <td class="py-3 px-4 font-bold text-white">
                        <div class="flex items-center gap-2">
                            <span class="text-xl">${item.flag}</span>
                            <span>${item.name}</span>
                        </div>
                    </td>
                    <td class="py-3 px-3 text-center">
                        <span class="px-2 py-0.5 rounded text-xs bg-slate-800 text-slate-300 border border-slate-700 font-mono">${item.teams}</span>
                    </td>
                    <td class="py-3 px-2 text-center text-xs ${currentViewMode === 'forecast' ? 'line-through text-red-400/60' : 'text-slate-400'}">${item.s1.toFixed(3)}</td>
                    <td class="py-3 px-2 text-center text-xs text-slate-400">${item.s2.toFixed(3)}</td>
                    <td class="py-3 px-2 text-center text-xs text-slate-400">${item.s3.toFixed(3)}</td>
                    <td class="py-3 px-2 text-center text-xs text-slate-400">${item.s4.toFixed(3)}</td>
                    <td class="py-3 px-2 text-center text-xs text-uefa-accent font-bold">${item.s5.toFixed(3)}</td>
                    <td class="py-3 px-4 text-right font-extrabold text-white text-base font-mono">${total}</td>
                    <td class="py-3 px-4 text-center">${slotsBadge}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Return allocation badge for UEFA competitions
        function getSlotsBadge(rank) {
            if (rank <= 4) {
                return `<span class="bg-blue-600/20 text-blue-400 border border-blue-500/40 px-2 py-1 rounded text-[11px] font-bold">4x UCL Ligaphase</span>`;
            } else if (rank === 5) {
                return `<span class="bg-cyan-600/20 text-cyan-400 border border-cyan-500/40 px-2 py-1 rounded text-[11px] font-bold">3x UCL / 1x Quali</span>`;
            } else if (rank === 6) {
                return `<span class="bg-indigo-600/20 text-indigo-400 border border-indigo-500/40 px-2 py-1 rounded text-[11px] font-bold">2x UCL / 1x Quali</span>`;
            } else if (rank <= 10) {
                return `<span class="bg-amber-600/20 text-amber-400 border border-amber-500/40 px-2 py-1 rounded text-[11px] font-bold">1x UCL Ligaphase</span>`;
            } else if (rank <= 15) {
                return `<span class="bg-orange-600/20 text-orange-400 border border-orange-500/40 px-2 py-1 rounded text-[11px] font-bold">2x UCL Quali</span>`;
            } else {
                return `<span class="bg-slate-700 text-slate-300 px-2 py-1 rounded text-[11px]">1x UCL Quali</span>`;
            }
        }

        // Switch View Modes (Current vs Forecast)
        function switchView(mode) {
            currentViewMode = mode;
            const btnCurrent = document.getElementById('tab-current');
            const btnForecast = document.getElementById('tab-forecast');

            if (mode === 'current') {
                btnCurrent.className = "flex-1 md:flex-none px-4 py-1.5 rounded-md text-xs font-semibold bg-uefa-blue text-white shadow transition";
                btnForecast.className = "flex-1 md:flex-none px-4 py-1.5 rounded-md text-xs font-semibold text-slate-400 hover:text-white transition";
            } else {
                btnForecast.className = "flex-1 md:flex-none px-4 py-1.5 rounded-md text-xs font-semibold bg-uefa-blue text-white shadow transition";
                btnCurrent.className = "flex-1 md:flex-none px-4 py-1.5 rounded-md text-xs font-semibold text-slate-400 hover:text-white transition";
            }
            renderTable();
        }

        // Search Filter
        function filterTable() {
            const query = document.getElementById('search-input').value.toLowerCase();
            const rows = document.querySelectorAll('#table-body tr');

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(query)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        // Sort Toggle
        let sortAsc = false;
        function sortTableByTotal() {
            sortAsc = !sortAsc;
            countryData.sort((a, b) => {
                const totalA = a.s1 + a.s2 + a.s3 + a.s4 + a.s5;
                const totalB = b.s1 + b.s2 + b.s3 + b.s4 + b.s5;
                return sortAsc ? totalA - totalB : totalB - totalA;
            });
            renderTable();
        }

        // Open Detail Modal
        function openModal(item, rank) {
            document.getElementById('modal-flag').innerText = item.flag;
            document.getElementById('modal-country-name').innerText = item.name;
            document.getElementById('modal-rank-info').innerText = `Rang ${rank} in der UEFA 5-Jahreswertung`;
            
            document.getElementById('m-s1').innerText = item.s1.toFixed(3);
            document.getElementById('m-s2').innerText = item.s2.toFixed(3);
            document.getElementById('m-s3').innerText = item.s3.toFixed(3);
            document.getElementById('m-s4').innerText = item.s4.toFixed(3);
            document.getElementById('m-s5').innerText = item.s5.toFixed(3);

            document.getElementById('modal-drop-text').innerText = `Für die Saison 2027/28 verliert ${item.name} die ${item.s1.toFixed(3)} Punkte aus der Saison 22/23.`;

            // Qualification breakdown
            const slotsContainer = document.getElementById('modal-slots-container');
            slotsContainer.innerHTML = getDetailedQualificationSlots(rank);

            document.getElementById('country-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('country-modal').classList.add('hidden');
        }

        // Detailed UEFA Startplatz Distribution Logic
        function getDetailedQualificationSlots(rank) {
            if (rank <= 4) {
                return `
                    <div class="flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-lg">
                        <span class="flex items-center gap-2 text-xs font-semibold text-blue-400"><i class="fa-solid fa-star"></i> UEFA Champions League (Platz 1-4)</span>
                        <span class="text-xs font-bold text-slate-200">4x Ligaphase (Direkt)</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-lg">
                        <span class="flex items-center gap-2 text-xs font-semibold text-amber-400"><i class="fa-solid fa-trophy"></i> UEFA Europa League (Platz 5 & Pokalsieger)</span>
                        <span class="text-xs font-bold text-slate-200">2x Ligaphase (Direkt)</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-lg">
                        <span class="flex items-center gap-2 text-xs font-semibold text-emerald-400"><i class="fa-solid fa-shield-halved"></i> UEFA Conference League (Platz 6/7)</span>
                        <span class="text-xs font-bold text-slate-200">1x Playoffs</span>
                    </div>
                `;
            } else if (rank === 5) {
                return `
                    <div class="flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-lg">
                        <span class="flex items-center gap-2 text-xs font-semibold text-blue-400"><i class="fa-solid fa-star"></i> UEFA Champions League</span>
                        <span class="text-xs font-bold text-slate-200">3x Direkt / 1x Q3</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-lg">
                        <span class="flex items-center gap-2 text-xs font-semibold text-amber-400"><i class="fa-solid fa-trophy"></i> UEFA Europa League</span>
                        <span class="text-xs font-bold text-slate-200">2x Ligaphase</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-lg">
                        <span class="flex items-center gap-2 text-xs font-semibold text-emerald-400"><i class="fa-solid fa-shield-halved"></i> UEFA Conference League</span>
                        <span class="text-xs font-bold text-slate-200">1x Playoffs</span>
                    </div>
                `;
            } else if (rank <= 10) {
                return `
                    <div class="flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-lg">
                        <span class="flex items-center gap-2 text-xs font-semibold text-blue-400"><i class="fa-solid fa-star"></i> UEFA Champions League</span>
                        <span class="text-xs font-bold text-slate-200">1x Direkt / 1x Q2</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-lg">
                        <span class="flex items-center gap-2 text-xs font-semibold text-amber-400"><i class="fa-solid fa-trophy"></i> UEFA Europa League</span>
                        <span class="text-xs font-bold text-slate-200">1x Direkt / 1x Q3</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-lg">
                        <span class="flex items-center gap-2 text-xs font-semibold text-emerald-400"><i class="fa-solid fa-shield-halved"></i> UEFA Conference League</span>
                        <span class="text-xs font-bold text-slate-200">1x Q2</span>
                    </div>
                `;
            } else {
                return `
                    <div class="flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-lg">
                        <span class="flex items-center gap-2 text-xs font-semibold text-blue-400"><i class="fa-solid fa-star"></i> UEFA Champions League</span>
                        <span class="text-xs font-bold text-slate-200">2x Qualifikation (Q2/Q1)</span>
                    </div>
                    <div class="flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-lg">
                        <span class="flex items-center gap-2 text-xs font-semibold text-emerald-400"><i class="fa-solid fa-shield-halved"></i> UEFA Conference League</span>
                        <span class="text-xs font-bold text-slate-200">2x Q2</span>
                    </div>
                `;
            }
        }

        // AI Sync Simulation Trigger
        function triggerAISync() {
            const icon = document.getElementById('sync-icon');
            const btn = document.getElementById('sync-btn');
            
            icon.classList.add('fa-spin');
            btn.classList.add('opacity-75');

            setTimeout(() => {
                // Simulate realistic random coefficient gain after matches
                countryData.forEach(c => {
                    c.s5 += Math.floor(Math.random() * 300) / 1000;
                });

                const now = new Date();
                const timeString = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                document.getElementById('last-update-time').innerText = `Gerade eben um ${timeString} Uhr (KI Parsed)`;

                renderTable();
                
                icon.classList.remove('fa-spin');
                btn.classList.remove('opacity-75');
            }, 1200);
        }

        // Export Data to CSV
        function exportCSV() {
            let csvContent = "data:text/csv;charset=utf-8,Rang;Land;Teams;22/23;23/24;24/25;25/26;26/27;Gesamt\n";
            countryData.forEach((c, index) => {
                const total = (c.s1 + c.s2 + c.s3 + c.s4 + c.s5).toFixed(3);
                csvContent += `${index + 1};${c.name};${c.teams};${c.s1};${c.s2};${c.s3};${c.s4};${c.s5};${total}\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "UEFA_5_Jahreswertung_2026_27.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Theme Toggle Functionality
        function toggleDarkMode() {
            const html = document.documentElement;
            const icon = document.getElementById('theme-toggle-icon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                html.classList.add('light');
                icon.classList.remove('fa-moon');
                icon.classList.add('fa-sun');
            } else {
                html.classList.remove('light');
                html.classList.add('dark');
                icon.classList.remove('fa-sun');
                icon.classList.add('fa-moon');
            }
        }

        // Chart.js Comparison Initialization
        let chartInstance = null;
        function toggleChartModal() {
            const modal = document.getElementById('chart-modal');
            modal.classList.toggle('hidden');

            if (!modal.classList.contains('hidden') && !chartInstance) {
                const ctx = document.getElementById('rankingChart').getContext('2d');
                const top5 = countryData.slice(0, 5);

                chartInstance = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: ['2022/23', '2023/24', '2024/25', '2025/26', '2026/27'],
                        datasets: top5.map((c, i) => ({
                            label: c.name,
                            data: [c.s1, c.s2, c.s3, c.s4, c.s5],
                            borderColor: ['#00F0FF', '#FFD700', '#FF4B4B', '#10B981', '#A855F7'][i],
                            backgroundColor: 'transparent',
                            tension: 0.3,
                            borderWidth: 3
                        }))
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { labels: { color: '#CBD5E1' } }
                        },
                        scales: {
                            x: { grid: { color: 'rgba(255,255,255,0.1)' }, ticks: { color: '#94A3B8' } },
                            y: { grid: { color: 'rgba(255,255,255,0.1)' }, ticks: { color: '#94A3B8' } }
                        }
                    }
                });
            }
        }

        // Initial Page Load Execution
        window.onload = function() {
            renderTable();
        };
    </script>
</body>
